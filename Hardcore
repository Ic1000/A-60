local isJumpscaring = false

local function TriggerJumpscare()
    if isJumpscaring then return end
    isJumpscaring = true

    local player = game.Players.LocalPlayer
    local char = player.Character
    local humanoid = char and char:FindFirstChildOfClass("Humanoid")

    local parentContainer = player:WaitForChild("PlayerGui")
    pcall(function()
        if gethui then parentContainer = gethui() end
    end)

    local JumpscareGui = Instance.new("ScreenGui")
    JumpscareGui.Name = "JumpscareGui"
    JumpscareGui.IgnoreGuiInset = true
    JumpscareGui.DisplayOrder = 2147483647
    JumpscareGui.Parent = parentContainer

    local Background = Instance.new("Frame")
    Background.Name = "Background"
    Background.BackgroundColor3 = Color3.fromRGB(150, 0, 0)
    Background.BorderSizePixel = 0
    Background.Size = UDim2.new(1, 0, 1, 0)
    Background.ZIndex = 1
    Background.Parent = JumpscareGui

    local Face = Instance.new("ImageLabel")
    Face.Name = "Face"
    Face.AnchorPoint = Vector2.new(0.5, 0.5)
    Face.BackgroundTransparency = 1
    Face.Position = UDim2.new(0.5, 0, 0.5, 0)
    Face.Size = UDim2.new(0, 650, 0, 650)
    Face.ImageTransparency = 0
    Face.ZIndex = 999
    Face.Image = A60_IMAGE_ID
    Face.Parent = JumpscareGui

    local scare = Instance.new("Sound")
    scare.Parent = JumpscareGui
    scare.SoundId = "rbxassetid://9114221327"
    scare.Volume = 10
    scare:Play()

    task.spawn(function()
        while JumpscareGui and JumpscareGui.Parent do
            Background.BackgroundColor3 = Color3.fromRGB(180, 0, 0)
            Face.Position = UDim2.new(0.5, math.random(-30, 30), 0.5, math.random(-30, 30))
            task.wait(0.03)
            Background.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
            Face.Position = UDim2.new(0.5, math.random(-30, 30), 0.5, math.random(-30, 30))
            task.wait(0.03)
        end
    end)

    task.wait(0.85)
    JumpscareGui:Destroy()
    if humanoid then
        humanoid.Health = 0
    end
end

