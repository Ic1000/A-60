local Players = game:GetService("Players")

---====== Load spawner ======---
local spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Entity%20Spawner/V2/Source.lua"))()

---====== Create entity ======---
local entity = spawner.Create({
    Entity = {
        Name = "Hardcore A-60",
        Asset = "rbxassetid://16138462624",
        HeightOffset = 0
    },
    Lights = {
        Flicker = { Enabled = false, Duration = 1 },
        Shatter = true,
        Repair = false
    },
    Earthquake = { Enabled = false },
    CameraShake = {
        Enabled = true,
        Range = 200,
        Values = {1.5, 20, 0.1, 1}
    },
    Movement = {
        Speed = 350,
        Delay = math.random(1, 2),
        Reversed = false
    },
    Rebounding = {
        Enabled = true,
        Type = "Ambush",
        Min = 2,
        Max = math.random(1, 8),
        Delay = math.random(0.5, 1.5) / 0.5
    },
    Damage = {
        Enabled = true,
        Range = 80,
        Amount = 125
    },
    Crucifixion = {
        Enabled = true,
        Range = 40,
        Resist = false,
        Break = true
    },
    Death = {
        Type = "Guiding",
        Hints = {"You died to Hardcore A-60...", "He will announce his presence with a loud scream.", "Hes fast and he can rebound, so stay hidden until hes gone!", "Im Sure Youll Make it!"},
        Cause = ""
    }
})

---====== Debug entity ======---
entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")
end)

entity:SetCallback("OnStartMoving", function()
    print("Entity has started moving")
end)

entity:SetCallback("OnEnterRoom", function(room, firstTime)
    if firstTime == true then
        print("Entity has entered room: ".. room.Name.. " for the first time")
    else
        print("Entity has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnLookAt", function(lineOfSight)
    if lineOfSight == true then
        print("Player is looking at entity")
    else
        print("Player view is obstructed by something")
    end
end)

entity:SetCallback("OnRebounding", function(startOfRebound)
    if startOfRebound == true then
        print("Entity has started rebounding")
    else
        print("Entity has finished rebounding")
    end
end)

entity:SetCallback("OnDespawning", function()
    print("Entity is despawning")
end)

entity:SetCallback("OnDespawned", function()
    print("Entity has despawned")
    
    -- Trao thành tựu 1 lần duy nhất
    local player = Players.LocalPlayer
    if player and not player:FindFirstChild("HardcoreA60AchievementUnlocked") then
        local flag = Instance.new("BoolValue")
        flag.Name = "HardcoreA60AchievementUnlocked"
        flag.Value = true
        flag.Parent = player

        pcall(function()
            local achievementGiver = loadstring(game:HttpGet("https://raw.githubusercontent.com/vct0721/Doors-Stuff/refs/heads/main/Other/Modifiyed%20Achivements%20Source"))()

            achievementGiver({
                Title = "I Cant Hear You",
                Desc = "Soundproof!",
                Reason = "Survive Silence",
                Image = "rbxassetid://12309073114"
            })
        end)
    end
end)

---====== Jumpscare Fix (Chạy trước khi Guiding Light hiện) ======---
entity:SetCallback("OnDamagePlayer", function(newHealth)
    if newHealth <= 0 then
        print("Entity has killed the player")

        pcall(function()
            -- Chạy Jumpscare ngay lập tức không chậm trễ
            local Jumpscare = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/Utilities/main/Doors/Jumpscare%20Creator/Source.lua"))()

            Jumpscare({
                Image1 = "rbxassetid://14826206904",
                Image2 = "rbxassetid://14826206904",
                Sound1 = "rbxassetid://9114221327",
                Sound2 = "rbxassetid://9114221327",
                Shake = true,
                Teeth = true,
                Duration = 2
            })
        end)
    else
        print("Entity has damaged the player")
    end
end)

---====== Run entity ======---
entity:Run()
