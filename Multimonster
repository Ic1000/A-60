local function BreakRoom(room)
    if not room then return end

    task.spawn(function()
        task.wait(0.02)

        local assets = room:FindFirstChild("Assets") or room

        -- Âm thanh va đập chính của căn phòng khi entity đi qua
        local mainBreak = Instance.new("Sound")
        mainBreak.SoundId = "rbxassetid://9114223171"
        mainBreak.Volume = 2.5
        mainBreak.Parent = assets
        mainBreak:Play()

        mainBreak.Ended:Connect(function()
            mainBreak:Destroy()
        end)

        local breakSounds = {
            "rbxassetid://9125992545",
            "rbxassetid://4004052860",
            "rbxassetid://7142857558",
            "rbxassetid://7142843615",
            "rbxassetid://2612674531",
            "rbxassetid://2174790942"
        }

        local blacklist = {
            "wardrobe", "bed", "rug", "key", "drawer",
            "book", "breaker", "table", "desk", "gold", "dresser"
        }

        for _, item in ipairs(assets:GetChildren()) do
            if item:IsA("Model") and item.Name ~= "Door" and item.Name ~= "HidingSpots" then
                local lowerName = string.lower(item.Name)
                local blocked = false

                for _, word in ipairs(blacklist) do
                    if string.find(lowerName, word) then
                        blocked = true
                        break
                    end
                end

                if not blocked then
                    task.spawn(function()
                        for _, part in ipairs(item:GetDescendants()) do
                            if part:IsA("BasePart") then
                                local n = string.lower(part.Name)

                                if not string.find(n, "floor") and not string.find(n, "hitbox") then
                                    -- Âm thanh gãy vỡ cho từng part
                                    local sound = Instance.new("Sound")
                                    sound.SoundId = breakSounds[math.random(1, #breakSounds)]
                                    sound.Volume = math.random(12, 24) / 10
                                    sound.PlaybackSpeed = math.random(85, 115) / 100
                                    sound.RollOffMaxDistance = 100
                                    sound.Parent = part
                                    sound:Play()

                                    sound.Ended:Connect(function()
                                        sound:Destroy()
                                    end)

                                    -- 1. Unanchor và cấp quyền xử lý vật lý trực tiếp cho LocalPlayer
                                    part.Anchored = false
                                    part.CanCollide = true

                                    pcall(function()
                                        if part:CanSetNetworkOwnership() then
                                            part:SetNetworkOwner(LocalPlayer)
                                        end
                                    end)

                                    -- 2. Đặt thuộc tính vật lý siêu nhẹ để bay mượt & bẩy cao hơn
                                    part.CustomPhysicalProperties = PhysicalProperties.new(
                                        0.05, -- Density (nhẹ để văng xa)
                                        0.1,  -- Friction
                                        0.8,  -- Elasticity (độ nảy cao)
                                        1,
                                        1
                                    )

                                    -- 3. Đẩy nhẹ CFrame lên khỏi mặt sàn để tránh bị kẹt colision sàn
                                    part.CFrame = part.CFrame + Vector3.new(0, 0.4, 0)

                                    -- 4. Kích hoạt lực văng trực tiếp ngay lập tức
                                    local randomForce = Vector3.new(
                                        math.random(-80, 80),
                                        math.random(40, 90), -- Đẩy mạnh lên không trung
                                        math.random(-80, 80)
                                    )

                                    local randomRot = Vector3.new(
                                        math.random(-40, 40),
                                        math.random(-40, 40),
                                        math.random(-40, 40)
                                    )

                                    part.AssemblyLinearVelocity = randomForce
                                    part.AssemblyAngularVelocity = randomRot

                                    -- Lực đẩy bổ sung Impulse để ép Physics Engine tính toán ngay lập tức
                                    pcall(function()
                                        part:ApplyImpulse(randomForce * part:GetMass())
                                    end)
                                end
                            end
                        end
                    end)
                end
            end
        end
    end)
end

