		followConnection = nil
	end
	if extraModel and extraModel.Parent then
		extraModel:Destroy()
		extraModel = nil
	end
end

local function BreakRoom(room)
	if not room then return end
	task.spawn(function()
		local assets = room:FindFirstChild("Assets") or room
		local roomRoot = room.PrimaryPart or room:FindFirstChildWhichIsA("BasePart")
		if roomRoot then
			local mainBreak = Instance.new("Sound")
			mainBreak.SoundId = "rbxassetid://9114223171"
			mainBreak.Volume = 3.5
			mainBreak.RollOffMaxDistance = 150
			mainBreak.Parent = roomRoot
			mainBreak:Play()
			mainBreak.Ended:Connect(function() mainBreak:Destroy() end)
		end
		
		local breakSounds = {
			"rbxassetid://9125992545",
			"rbxassetid://4004052860",
			"rbxassetid://7142857558",
			"rbxassetid://7142843615",
			"rbxassetid://2612674531",
			"rbxassetid://2174790942"
		}
		local blacklist = { "wardrobe", "bed", "rug", "key", "drawer", "book", "breaker", "table", "desk", "gold", "dresser" }
		
		for _, item in ipairs(assets:GetChildren()) do
			if item:IsA("Model") and item.Name ~= "Door" and item.Name ~= "HidingSpots" then
				local lowerName = string.lower(item.Name)
				local blocked = false
				for _, word in ipairs(blacklist) do
					if string.find(lowerName, word) then
						blocked = true
						break
					end
				end
				if not blocked then
					for _, part in ipairs(item:GetDescendants()) do
						if part:IsA("BasePart") then
							local n = string.lower(part.Name)
							if not string.find(n, "floor") and not string.find(n, "hitbox") and not string.find(n, "wall") then
								part:BreakJoints()
								part.Anchored = false
								part.CanCollide = true
								part.CustomPhysicalProperties = PhysicalProperties.new(2.5, 0.3, 0.1, 1, 1)
								part.AssemblyLinearVelocity = Vector3.new(
									math.random(-45, 45),
									math.random(10, 30),
									math.random(-45, 45)
								)
								part.AssemblyAngularVelocity = Vector3.new(
									math.random(-15, 15),
									math.random(-15, 15),
									math.random(-15, 15)
								)
								task.spawn(function()
									for i = 1, 6 do
										task.wait(0.25)
										if part and part.Parent and not part.Anchored then
											part.AssemblyLinearVelocity = Vector3.new(
												part.AssemblyLinearVelocity.X,
												-45,
												part.AssemblyLinearVelocity.Z
											)
										end
									end
								end)
								if math.random(1, 2) == 1 then
									task.spawn(function()
										local sound = Instance.new("Sound")
										sound.SoundId = breakSounds[math.random(1, #breakSounds)]
										sound.Volume = math.random(12, 24) / 10
										sound.PlaybackSpeed = math.random(85, 115) / 100
										sound.RollOffMaxDistance = 100
										sound.Parent = part
										sound:Play()
										sound.Ended:Connect(function() sound:Destroy() end)
									end)
								end
							end
						end
					end
				end
			end
		end
	end)
end

-- Hàm kích hoạt rung cực mạnh khi Despawn
local function TriggerExtremeShake()
	task.spawn(function()
		pcall(function()
			local CameraShakerModule = require(ReplicatedStorage:WaitForChild("CameraShaker", 5))
			local camera = Workspace.CurrentCamera
			if CameraShakerModule and camera then
				local despawnShake = CameraShakerModule.new(Enum.RenderPriority.Camera.Value, function(cf)
					camera.CFrame = camera.CFrame * cf
				end)
				despawnShake:Start()
				despawnShake:ShakeOnce(35, 25, 0.05, 5)
			end
		end)
	end)
end

