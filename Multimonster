entity:SetCallback("OnSpawned", function()
	print("multimonster has spawned")
	local part = Workspace:WaitForChild("multimonster", 5)
	if not part then return end

	FilterEntitySounds(part)

	pcall(function()
		local objects = game:GetObjects("rbxassetid://14826206904")
		if objects and objects[1] then
			extraModel = objects[1]
			extraModel.Name = "Extra_Invisible_Model"
			MakeInvisible(extraModel)
			extraModel.Parent = Workspace
		end
	end)

	if extraModel and part then
		followConnection = RunService.RenderStepped:Connect(function()
			if part and part.Parent and extraModel and extraModel.Parent then
				FilterEntitySounds(part)
				local primary = part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
				if primary then
					extraModel:PivotTo(primary.CFrame)
				end
			else
				CleanUpExtraModel()
			end
		end)
	end

	local object = part:WaitForChild("RushNew", 5)
	if not object then return end
	local attachment = object:WaitForChild("Main", 5)
	local e = attachment and attachment:WaitForChild("Face", 5)
	
	if object:IsA("BasePart") then
		object.CanCollide = false
	end
	if not e then return end
	
	local originalTexture = e.Texture
	task.spawn(function()
		local textures = {
			"rbxassetid://12145534911",
			"rbxassetid://12145554242",
			"rbxassetid://12145599498",
			"rbxassetid://12145599275",
			"rbxassetid://12155335619",
			"rbxassetid://12145598814",
			"rbxassetid://12146135062",
			"rbxassetid://11378285585"
		}
		while part and part.Parent do
			if isJumpscaring then
				for _, tex in ipairs(textures) do
					if not isJumpscaring then break end
					e.Texture = tex
					task.wait(0.03)
				end
			else
				if e.Texture ~= originalTexture then
					e.Texture = originalTexture
				end
				task.wait(0.1)
			end
		end
	end)
end)

entity:SetCallback("OnStartMoving", function()
	print("multimonster has started moving")

	task.spawn(function()
		while task.wait(0.05) do
			local player = Players.LocalPlayer
			local character = player.Character or player.CharacterAdded:Wait()
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			local HumanoidRootPart = character:FindFirstChild("HumanoidRootPart")
			local womp = Workspace:FindFirstChild("multimonster")
			
			-- Kiểm tra nếu người chơi chết (máu bằng 0), tắt ngay mọi âm thanh của thực thể và dừng rung
			if not humanoid or humanoid.Health <= 0 then
				if womp then
					for _, snd in ipairs(womp:GetDescendants()) do
						if snd:IsA("Sound") then
							snd:Stop()
						end
					end
				end
				break
			end

			if not womp then break end
			local wompwomp = womp:FindFirstChild("RushNew")
			if not wompwomp then break end
			if not HumanoidRootPart then continue end
			
			local distance = (HumanoidRootPart.Position - wompwomp.Position).Magnitude
			
			local raycastParams = RaycastParams.new()
			raycastParams.FilterType = Enum.RaycastFilterType.Exclude
			raycastParams.FilterDescendantsInstances = {womp, character}
			
			local raycastResult = Workspace:Raycast(wompwomp.Position, (HumanoidRootPart.Position - wompwomp.Position), raycastParams)
			local canSeePlayer = (raycastResult == nil)
			
			if (distance <= 30 or (canSeePlayer and distance <= 60)) then
				if not character:GetAttribute("Hiding") and not debounce then
					debounce = true
					isJumpscaring = true
					local lockCFrameConnection = nil
					local camera = Workspace.CurrentCamera
					local oldCameraType = camera.CameraType
					local jumpscareModel = nil
					
					pcall(function()
						if HumanoidRootPart then
							HumanoidRootPart.Anchored = true
						end
						
						local lockedCFrame = camera.CFrame
						camera.CameraType = Enum.CameraType.Scriptable
						
						local entitySounds = {}
						for _, v in pairs(womp:GetDescendants()) do
							if v:IsA("Sound") and v.IsPlaying then
								table.insert(entitySounds, {sound = v, vol = v.Volume})
								v.Volume = 0
							end
						end
						
						local savedTransparencies = {}
						if wompwomp:IsA("BasePart") then
							savedTransparencies[wompwomp] = wompwomp.Transparency
							wompwomp.Transparency = 1
						end
						for _, child in ipairs(wompwomp:GetDescendants()) do
							if child:IsA("BasePart") or child:IsA("Decal") then
								savedTransparencies[child] = child.Transparency
								child.Transparency = 1
							end
						end
						
						local loadedObjects = game:GetObjects(JUMPSCARE_MODEL_ID)
						if loadedObjects and #loadedObjects > 0 then
							jumpscareModel = loadedObjects[1]
							jumpscareModel.Parent = Workspace
							for _, p in ipairs(jumpscareModel:GetDescendants()) do
								if p:IsA("BasePart") then
									p.CanCollide = false
									p.Anchored = true
								end
							end
						else
							jumpscareModel = wompwomp
							if jumpscareModel:IsA("BasePart") then
								jumpscareModel.Anchored = true
							end
						end
						
						local CameraShakerModule = require(ReplicatedStorage:WaitForChild("CameraShaker"))
						local jumpCamShake = CameraShakerModule.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
							camera.CFrame = lockedCFrame * shakeCf
						end)
						jumpCamShake:Start()
						jumpCamShake:ShakeOnce(10, 10, 0, 5.5, 1, 0)
						
						lockCFrameConnection = RunService.RenderStepped:Connect(function()
							if not isJumpscaring then return end
							camera.CameraType = Enum.CameraType.Scriptable
							if jumpscareModel then
								local targetCFrame = camera.CFrame * CFrame.new(0, -0.5, -4.5)
								if jumpscareModel:IsA("Model") then
									jumpscareModel:PivotTo(targetCFrame)
								elseif jumpscareModel:IsA("BasePart") then
									jumpscareModel.CFrame = targetCFrame
								end
							end
						end)
						
						local scareSound = GetGitSound("https://github.com/thefigureblack/audios/blob/main/asixtyScareOmg.mp3?raw=true", "asixtyScareOmg")
						scareSound.Parent = Workspace
						scareSound.Volume = 5
						scareSound:Play()
						
						task.wait(0.5)
						
						if lockCFrameConnection then
							lockCFrameConnection:Disconnect()
							lockCFrameConnection = nil
						end
						if jumpCamShake then
							jumpCamShake:Stop()
						end
						
						-- RESET HOÀN TOÀN CAMERA ĐỂ KHÔNG BỊ NGHIÊNG
						camera.CameraType = Enum.CameraType.Custom
						local humanoidObj = character:FindFirstChildOfClass("Humanoid")
						if humanoidObj then
							camera.CameraSubject = humanoidObj
						end
						if HumanoidRootPart then
							camera.CFrame = CFrame.new(camera.CFrame.Position, HumanoidRootPart.Position + HumanoidRootPart.CFrame.LookVector * 100)
						end
						
						for _, sndData in ipairs(entitySounds) do
							if sndData.sound and sndData.sound.Parent then
								sndData.sound.Volume = sndData.vol or 1
							end
						end
						
						if jumpscareModel and jumpscareModel ~= wompwomp then
							jumpscareModel:Destroy()
						end
						for part, originalTransparency in pairs(savedTransparencies) do
							if part and part.Parent then
								part.Transparency = originalTransparency
							end
						end
						
						local screenGui = Instance.new("ScreenGui")
						screenGui.Name = "A60_JumpscareGui"
						screenGui.Parent = player:WaitForChild("PlayerGui")
						screenGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
						
						local randomSelectedImage = ALL_JUMPSCARE_IMAGES[math.random(1, #ALL_JUMPSCARE_IMAGES)]
						local jumpscareImg = Instance.new("ImageLabel")
						jumpscareImg.Name = "JumpscareImage"
						jumpscareImg.Parent = screenGui
						jumpscareImg.AnchorPoint = Vector2.new(0.5, 0.5)
						jumpscareImg.Position = UDim2.new(0.5, 0, 0.5, 0)
						jumpscareImg.Size = UDim2.new(0, 0, 0, 0)
						jumpscareImg.BackgroundTransparency = 1
						jumpscareImg.Image = randomSelectedImage
						jumpscareImg.ImageTransparency = 0
						
						local colorCorrection = Instance.new("ColorCorrectionEffect", Lighting)
						TweenService:Create(colorCorrection, TweenInfo.new(0.2), {
							Brightness = 0.2,
							Contrast = 0.3,
							Saturation = -0.3,
							TintColor = Color3.fromRGB(255, 0, 4),
						}):Play()
						
						if HumanoidRootPart then
							HumanoidRootPart.Anchored = false
						end
						humanoid.Health = 0
						
						-- Phóng to ảnh Jumpscare 2D
						TweenService:Create(jumpscareImg, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
							Size = UDim2.new(1.2, 0, 1.4, 0),
							Rotation = math.random(-25, 25)
						}):Play()
						
						-- ĐỢI LÂU HƠN TRÊN MẶT NGƯỜI CHƠI (1.5 giây)
						task.wait(0.5)
						isJumpscaring = false
						
						-- TÀNG HÌNH TỪ TỪ (1.0 giây)
						TweenService:Create(jumpscareImg, TweenInfo.new(3.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { ImageTransparency = 1 }):Play()
						TweenService:Create(colorCorrection, TweenInfo.new(0.5), {
							Brightness = 0,
							Contrast = 0,
							Saturation = 0,
							TintColor = Color3.fromRGB(255, 255, 255),
						}):Play()
						
						Debris:AddItem(screenGui, 2.5)
						Debris:AddItem(colorCorrection, 2.5)
						Debris:AddItem(scareSound, 2.5)
						
						-- HIỆU ỨNG RUNG HẬU JUMPSCARE (Tự tắt khi máu <= 0 hoặc hết 3 giây)
						task.spawn(function()
							local postShake = CameraShakerModule.new(Enum.RenderPriority.Camera.Value, function(shakeCf)
								camera.CFrame = camera.CFrame * cf
							end)
							postShake:Start()
							
							local startTime = tick()
							while tick() - startTime < 1.5 and humanoid and humanoid.Health > 0 and character and character.Parent do
								postShake:ShakeOnce(14, 20, 0.05, 0.1)
								task.wait(0.1)
							end
							
							postShake:Stop()
						end)
						
						task.wait(1)
						debounce = false
					end)
				end
			end
		end
	end)
end)

