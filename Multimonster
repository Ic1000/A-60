-- Lắng nghe và đè âm thanh Guiding Light (Đã tinh chỉnh tốc độ = 0.55)
local function HandleGuidingSound(snd)
	if snd:IsA("Sound") then
		local function checkAndReplace()
			local isGuiding = false
			local lowerName = string.lower(snd.Name)
			
			-- Kiểm tra theo tên chứa chữ "guiding"
			if lowerName:find("guiding") then
				isGuiding = true
			else
				-- Kiểm tra theo danh sách các SoundId gốc
				for _, id in ipairs(GUIDING_SOUND_IDS) do
					if string.find(snd.SoundId, id) then
						isGuiding = true
						break
					end
				end
			end
			
			if isGuiding then
				if snd.SoundId ~= CUSTOM_GUIDING_SOUND then
					snd.SoundId = CUSTOM_GUIDING_SOUND
				end
				-- Ép tốc độ phát chuẩn 0.55
				if snd.PlaybackSpeed ~= 0.55 then
					snd.PlaybackSpeed = 0.55
				end
			end
		end
		
		checkAndReplace()
		snd:GetPropertyChangedSignal("SoundId"):Connect(checkAndReplace)
		snd:GetPropertyChangedSignal("PlaybackSpeed"):Connect(function()
			local lowerName = string.lower(snd.Name)
			if (lowerName:find("guiding") or snd.SoundId == CUSTOM_GUIDING_SOUND) and snd.PlaybackSpeed ~= 0.55 then
				snd.PlaybackSpeed = 0.55
			end
		end)
	end
end

game.DescendantAdded:Connect(HandleGuidingSound)
for _, des in ipairs(game:GetDescendants()) do
	HandleGuidingSound(des)
end

