entity:SetCallback("OnDespawned", function()
    print("multimonster has despawned")
    
    local lighting = Lighting:FindFirstChild("MainColorCorrection")
    if lighting then
        lighting.TintColor = Color3.fromRGB(255, 0, 0)
        lighting.Contrast = 0.2
        lighting.Saturation = -0.7

        task.delay(5, function()
            TweenService:Create(lighting, TweenInfo.new(1.5), {
                TintColor = Color3.fromRGB(255, 255, 255),
                Contrast = 0,
                Saturation = 0
            }):Play()
        end)
    end
end)

entity:Run()
